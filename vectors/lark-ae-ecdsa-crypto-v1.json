  "curve": "secp256k1",
  "construction": {
    "host_commitment": "tagged_hash(\"s2c/ecdsa/data\", host_entropy)",
    "tweak": "tagged_hash(\"s2c/ecdsa/point\", signer_commitment || host_entropy)",
    "accept_if": "sig.r == (signer_commitment + tweak*G).x mod n",
    "tweak_out_of_range": "rejected, not reduced mod n"
  },
  "encoding_rules": {
    "signature": "DER, strictly canonical, optional single trailing sighash byte",
    "low_s_required": true,
    "scalars_in_range": "0 < r,s < n"
  },
  "notes": [
    "No pubkey or message_hash: these exercise the s2c relation only, so expected_ecdsa and expected_combined are null.",
    "expected_s2c=false cases are protocol failures, not malformed input; encoding-level rejection is covered by separate tests."
  ],
